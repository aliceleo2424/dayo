{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/magazine/:id",
      "destination": "https://dayo-sufk.vercel.app/magazine/:id"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "functions": {
    "api/send-lead-email.js": {
      "maxDuration": 15
    },
    "api/send-welcome.js": {
      "maxDuration": 15
    }
  }
}
